<view class="container">
  <!-- Tab 切换 -->
  <view class="admin-tabs">
    <view class="admin-tab {{adminTab == 0 ? 'active' : ''}}" bindtap="switchTab" data-index="0">仪表盘</view>
    <view class="admin-tab {{adminTab == 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1">陪诊员</view>
    <view class="admin-tab {{adminTab == 2 ? 'active' : ''}}" bindtap="switchTab" data-index="2">订单</view>
    <view class="admin-tab {{adminTab == 3 ? 'active' : ''}}" bindtap="switchTab" data-index="3">用户</view>
  </view>

  <!-- ===== 仪表盘 ===== -->
  <view wx:if="{{adminTab == 0}}">
    <view class="dashboard-grid">
      <view class="dash-card">
        <text class="dash-num">28</text>
        <text class="dash-label">今日订单</text>
        <text class="dash-change up">↑15%</text>
      </view>
      <view class="dash-card">
        <text class="dash-num">¥3,280</text>
        <text class="dash-label">今日收入</text>
        <text class="dash-change up">↑8%</text>
      </view>
      <view class="dash-card">
        <text class="dash-num">46</text>
        <text class="dash-label">陪诊员</text>
        <text class="dash-change up">↑5</text>
      </view>
      <view class="dash-card">
        <text class="dash-num">168</text>
        <text class="dash-label">总用户</text>
        <text class="dash-change up">↑23</text>
      </view>
    </view>

    <!-- 近7天数据 -->
    <view class="chart-card">
      <text class="card-title">近7天订单趋势</text>
      <view class="chart-bars">
        <view class="bar-item" wx:for="{{chartData}}" wx:key="index">
          <view class="bar" style="height: {{item.value * 2}}rpx;"></view>
          <text class="bar-label">{{item.day}}</text>
        </view>
      </view>
    </view>

    <!-- 排行榜 -->
    <view class="rank-card">
      <text class="card-title">陪诊员服务排行</text>
      <view class="rank-item" wx:for="{{rankList}}" wx:key="index">
        <text class="rank-num {{index < 3 ? 'top' : ''}}">{{index + 1}}</text>
        <text class="rank-name">{{item.name}}</text>
        <text class="rank-count">{{item.count}}次</text>
      </view>
    </view>
  </view>

  <!-- ===== 陪诊员管理 ===== -->
  <view wx:if="{{adminTab == 1}}">
    <input class="search-input" placeholder="搜索陪诊员" />
    <view class="staff-card" wx:for="{{staffList}}" wx:key="id">
      <view class="staff-info">
        <text class="staff-name">{{item.name}}</text>
        <text class="staff-status {{item.status == '已认证' ? 'verified' : 'pending'}}">{{item.status}}</text>
      </view>
      <text class="staff-detail">服务次数：{{item.count}}次 | 评分：{{item.rating}}分</text>
      <view class="staff-actions" wx:if="{{item.status == '待审核'}}">
        <button class="btn-approve" bindtap="approveStaff" data-id="{{item.id}}">通过</button>
        <button class="btn-reject" bindtap="rejectStaff" data-id="{{item.id}}">拒绝</button>
      </view>
    </view>
  </view>

  <!-- ===== 订单管理 ===== -->
  <view wx:if="{{adminTab == 2}}">
    <view class="order-card" wx:for="{{allOrders}}" wx:key="id">
      <view class="order-header">
        <text>#{{item.id}}</text>
        <text class="order-status {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <text class="order-detail">{{item.hospital}} - {{item.dept}} - {{item.date}}</text>
      <text class="order-detail">患者：{{item.patient}} | 陪诊员：{{item.escort}}</text>
    </view>
  </view>

  <!-- ===== 用户管理 ===== -->
  <view wx:if="{{adminTab == 3}}">
    <input class="search-input" placeholder="搜索用户" />
    <view class="user-card" wx:for="{{userList}}" wx:key="id">
      <text class="user-name">{{item.name}}</text>
      <text class="user-phone">{{item.phone}}</text>
      <text class="user-orders">{{item.orders}}次预约</text>
    </view>
  </view>
</view>