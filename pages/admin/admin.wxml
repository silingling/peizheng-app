<view class="page">
  <van-tabs active="{{adminTab}}" bind:change="switchTab">
    <van-tab title="仪表盘"></van-tab>
    <van-tab title="陪诊员"></van-tab>
    <van-tab title="订单"></van-tab>
    <van-tab title="用户"></van-tab>
  </van-tabs>

  <!-- 仪表盘 -->
  <view wx:if="{{adminTab == 0}}">
    <van-grid column-num="{{2}}" border="{{false}}" style="background:#fff;">
      <van-grid-item use-button-slot>
        <view class="dash-card"><text class="dash-num">28</text><text class="dash-label">今日订单</text><van-tag type="danger" size="mini">↑15%</van-tag></view>
      </van-grid-item>
      <van-grid-item use-button-slot>
        <view class="dash-card"><text class="dash-num">¥3,280</text><text class="dash-label">今日收入</text><van-tag type="danger" size="mini">↑8%</van-tag></view>
      </van-grid-item>
      <van-grid-item use-button-slot>
        <view class="dash-card"><text class="dash-num">46</text><text class="dash-label">陪诊员</text><van-tag type="success" size="mini">+5人</van-tag></view>
      </van-grid-item>
      <van-grid-item use-button-slot>
        <view class="dash-card"><text class="dash-num">168</text><text class="dash-label">总用户</text><van-tag type="success" size="mini">+23人</van-tag></view>
      </van-grid-item>
    </van-grid>

    <van-cell-group title="待处理">
      <van-cell title="待审核陪诊员" value="3人" is-link />
      <van-cell title="待处理订单" value="5单" is-link />
    </van-cell-group>
  </view>

  <!-- 陪诊员管理 -->
  <view wx:if="{{adminTab == 1}}">
    <van-search placeholder="搜索陪诊员" />
    <van-swipe-cell wx:for="{{staffList}}" wx:key="id" right-width="{{140}}">
      <van-cell center>
        <view slot="title">
          <text>{{item.name}}</text>
          <van-tag size="mini" type="{{item.statusClass == 'verified' ? 'success' : 'warning'}}" style="margin-left:8rpx;">{{item.status}}</van-tag>
        </view>
        <view slot="label">服务{{item.count}}次 · {{item.area}} · {{item.rating}}分</view>
        <view slot="right-icon" wx:if="{{item.statusClass == 'pending'}}">
          <van-button type="success" size="mini" bind:click="approveStaff">通过</van-button>
        </view>
      </van-cell>
      <view slot="right">
        <van-button type="danger" size="small">拒绝</van-button>
      </view>
    </van-swipe-cell>
  </view>

  <!-- 订单管理 -->
  <view wx:if="{{adminTab == 2}}">
    <van-cell wx:for="{{allOrders}}" wx:key="id">
      <view slot="title">
        <text>#{{item.id}} {{item.hospital}}</text>
        <van-tag size="mini" type="{{item.statusClass == 'done' ? 'success' : item.statusClass == 'ongoing' ? 'primary' : 'warning'}}" style="margin-left:8rpx;">{{item.statusText}}</van-tag>
      </view>
      <view slot="label">{{item.dept}} · {{item.date}} · {{item.patient}} · 陪诊员：{{item.escort}}</view>
      <view slot="value" style="color:#ee0a24;">¥{{item.price}}</view>
    </van-cell>
  </view>

  <!-- 用户管理 -->
  <view wx:if="{{adminTab == 3}}">
    <van-search placeholder="搜索用户" />
    <van-cell wx:for="{{userList}}" wx:key="id">
      <view slot="title">{{item.name}}</view>
      <view slot="label">{{item.phone}}</view>
      <view slot="value">{{item.orders}}次预约</view>
    </van-cell>
  </view>
</view>
