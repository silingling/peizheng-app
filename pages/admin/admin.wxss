page { background-color: #f5f7fa; }
.container { padding: 16rpx 0; }
.admin-tabs { display: flex; background: #fff; padding: 8rpx; margin-bottom: 2rpx; overflow-x: auto; }
.admin-tab { flex: 1; text-align: center; padding: 14rpx 8rpx; font-size: 24rpx; color: #666; white-space: nowrap; }
.admin-tab.active { background: #1aad8a; color: #fff; font-weight: 600; }

.dashboard-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rpx; margin-bottom: 2rpx; }
.dash-card { background: #fff; padding: 24rpx; }
.dash-num { font-size: 40rpx; font-weight: bold; color: #333; display: block; }
.dash-label { font-size: 24rpx; color: #999; margin-top: 4rpx; display: block; }
.dash-change { font-size: 22rpx; margin-top: 4rpx; display: block; }
.dash-change.up { color: #52c41a; }

.data-section { background: #fff; padding: 24rpx; margin-bottom: 2rpx; }
.ds-title { font-size: 30rpx; font-weight: 600; color: #333; display: block; margin-bottom: 16rpx; }
.ds-chart { }
.chart-bar { display: flex; align-items: center; margin-bottom: 12rpx; }
.cb-fill { height: 32rpx; background: #fa8c16; }
.cb-label { font-size: 22rpx; color: #666; margin-left: 12rpx; }

.quick-stats { display: flex; gap: 2rpx; }
.qs-card { flex: 1; background: #fff; padding: 24rpx; text-align: center; }
.qs-num { font-size: 48rpx; font-weight: bold; color: #ff4d4f; display: block; }
.qs-label { font-size: 24rpx; color: #666; margin-top: 4rpx; display: block; }

.search-row { padding: 16rpx 24rpx; background: #fff; margin-bottom: 2rpx; }
.admin-search { width: 100%; padding: 16rpx 20rpx; background: #f5f7fa; font-size: 28rpx; }

.staff-card { background: #fff; padding: 24rpx; margin-bottom: 2rpx; }
.sc-header { display: flex; align-items: center; margin-bottom: 8rpx; }
.sc-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #1aad8a; color: #fff; font-size: 28rpx; display: flex; align-items: center; justify-content: center; margin-right: 16rpx; }
.sc-info { flex: 1; }
.sc-name { font-size: 30rpx; font-weight: 600; color: #333; display: block; }
.sc-status { font-size: 22rpx; }
.sc-status.verified { color: #52c41a; }
.sc-status.pending { color: #fa8c16; }
.sc-rating { font-size: 28rpx; color: #fa8c16; }
.sc-data { display: flex; gap: 20rpx; margin-bottom: 12rpx; }
.sc-count, .sc-area { font-size: 24rpx; color: #999; }
.sc-actions { display: flex; gap: 16rpx; }
.btn-approve, .btn-reject { font-size: 26rpx; height: 56rpx; line-height: 56rpx; width: 160rpx; }
.btn-approve { background: #1aad8a; color: #fff; }
.btn-reject { background: #fff; color: #ff4d4f; border: 2rpx solid #ff4d4f; }

.order-card { background: #fff; padding: 20rpx 0; border-bottom: 2rpx solid #f0f0f0; }
.oc-header2 { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.oc-id { font-size: 24rpx; color: #999; }
.oc-status { font-size: 22rpx; padding: 2rpx 12rpx; }
.oc-status.pending { background: #fff7e6; color: #fa8c16; }
.oc-status.ongoing { background: #e6f7ff; color: #1890ff; }
.oc-status.done { background: #f6ffed; color: #52c41a; }
.oc-detail { font-size: 24rpx; color: #666; margin-top: 4rpx; display: block; }

.user-card { background: #fff; padding: 24rpx; display: flex; align-items: center; margin-bottom: 2rpx; }
.uc-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #1aad8a; color: #fff; font-size: 28rpx; display: flex; align-items: center; justify-content: center; margin-right: 16rpx; }
.uc-info { flex: 1; }
.uc-name { font-size: 28rpx; font-weight: 600; color: #333; display: block; }
.uc-phone { font-size: 24rpx; color: #999; margin-top: 2rpx; display: block; }
.uc-orders { font-size: 24rpx; color: #1aad8a; }
button::after { border: none; }
