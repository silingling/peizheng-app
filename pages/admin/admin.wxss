page { background-color: #f5f7fa; }
.container { padding: 16rpx 0; }
.admin-tabs {
  display: flex;
  background: #fff;
  padding: 8rpx;
  margin-bottom: 2rpx;
}
.admin-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #666;
}
.admin-tab.active { background: #1aad8a; color: #fff; font-weight: 600; }
.dashboard-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rpx; margin-bottom: 2rpx; }
.dash-card { background: #fff; padding: 24rpx; }
.dash-num { font-size: 40rpx; font-weight: bold; color: #333; display: block; }
.dash-label { font-size: 24rpx; color: #999; margin-top: 8rpx; display: block; }
.dash-change { font-size: 22rpx; margin-top: 8rpx; display: block; }
.dash-change.up { color: #52c41a; }
.chart-card, .rank-card { background: #fff; padding: 24rpx; margin-bottom: 2rpx; }
.card-title { font-size: 30rpx; font-weight: 600; color: #333; display: block; margin-bottom: 20rpx; }
.chart-bars { display: flex; justify-content: space-around; align-items: flex-end; height: 200rpx; }
.bar-item { text-align: center; }
.bar { width: 40rpx; background: linear-gradient(to top, #1aad8a, #20c997); margin: 0 auto; }
.bar-label { font-size: 22rpx; color: #999; margin-top: 8rpx; display: block; }
.rank-item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 2rpx solid #f0f0f0; }
.rank-item:last-child { border: none; }
.rank-num { width: 40rpx; font-size: 28rpx; font-weight: 600; color: #999; }
.rank-num.top { color: #fa8c16; }
.rank-name { flex: 1; font-size: 28rpx; color: #333; }
.rank-count { font-size: 26rpx; color: #999; }
.search-input { background: #fff; padding: 20rpx 24rpx; font-size: 28rpx; margin-bottom: 2rpx; }
.staff-card { background: #fff; padding: 24rpx; margin-bottom: 2rpx; border-bottom: 2rpx solid #f0f0f0; }
.staff-info { display: flex; align-items: center; margin-bottom: 8rpx; }
.staff-name { font-size: 30rpx; font-weight: 600; color: #333; }
.staff-status { font-size: 22rpx; padding: 4rpx 16rpx; margin-left: 16rpx; }
.staff-status.verified { background: #f6ffed; color: #52c41a; }
.staff-status.pending { background: #fff7e6; color: #fa8c16; }
.staff-detail { font-size: 26rpx; color: #999; display: block; }
.staff-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.btn-approve, .btn-reject { font-size: 26rpx; height: 60rpx; line-height: 60rpx; width: 160rpx; }
.btn-approve { background: #1aad8a; color: #fff; }
.btn-reject { background: #fff; color: #ff4d4f; border: 2rpx solid #ff4d4f; }
.order-detail { font-size: 26rpx; color: #666; display: block; margin-top: 4rpx; }
.user-card { background: #fff; padding: 24rpx; margin-bottom: 2rpx; display: flex; align-items: center; border-bottom: 2rpx solid #f0f0f0; }
.user-name { font-size: 30rpx; font-weight: 600; color: #333; flex: 1; }
.user-phone { font-size: 26rpx; color: #999; margin-right: 20rpx; }
.user-orders { font-size: 26rpx; color: #1aad8a; }
button::after { border: none; }
