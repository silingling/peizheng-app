<view class="page">
  <view class="apply-header">
    <text class="apply-title">加入我们，成为陪诊员</text>
    <text class="apply-desc">实名认证 · 免费培训 · 灵活接单 · 按单结算</text>
  </view>

  <van-steps steps="{{guideSteps}}" active="-1" active-color="#07c160" />

  <van-cell-group title="基本信息">
    <van-field value="{{name}}" placeholder="请填写身份证姓名" label="真实姓名" />
    <van-field value="{{phone}}" placeholder="请填写手机号" label="手机号" type="number" />
    <van-field value="{{idCard}}" placeholder="请填写身份证号" label="身份证号" />
    <van-field value="{{area}}" placeholder="如：北京市朝阳区" label="服务区域" />
  </van-cell-group>

  <van-cell-group title="从业背景">
    <view class="bg-wrap">
      <textarea class="bg-input" placeholder="请输入您的从业背景，如：护士、护工、退休医护人员等" />
    </view>
  </van-cell-group>

  <van-cell-group title="上传资料">
    <van-cell title="身份证正面" is-link bind:click="uploadID" icon="photograph" />
    <van-cell title="身份证反面" is-link bind:click="uploadBack" icon="photograph" />
    <van-cell title="资质证书" is-link bind:click="uploadCert" icon="description" />
    <van-cell title="本人照片" is-link bind:click="uploadPhoto" icon="photograph" />
  </van-cell-group>

  <view class="agree-wrap">
    <van-checkbox value="{{agree}}" bind:change="toggleAgree">我已阅读并同意《陪诊员入驻协议》</van-checkbox>
  </view>

  <view class="submit-wrap">
    <van-button type="primary" size="large" disabled="{{!agree}}" bind:click="submitApply">提交入驻申请</van-button>
  </view>
</view>
