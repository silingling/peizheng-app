page { background-color: #f5f7fa; }
.container { padding: 0; padding-bottom: 80rpx; }

.apply-header { background: linear-gradient(135deg, #1aad8a, #20c997); padding: 48rpx 32rpx; text-align: center; }
.apply-title { font-size: 36rpx; font-weight: bold; color: #fff; display: block; }
.apply-desc { font-size: 24rpx; color: rgba(255,255,255,0.85); margin-top: 12rpx; display: block; }

.step-guide { display: flex; flex-wrap: wrap; background: #fff; padding: 32rpx; margin-bottom: 2rpx; gap: 20rpx; }
.sg-item { display: flex; align-items: center; width: 45%; }
.sg-num { width: 44rpx; height: 44rpx; border-radius: 50%; background: #1aad8a; color: #fff; font-size: 24rpx; display: flex; align-items: center; justify-content: center; margin-right: 12rpx; flex-shrink: 0; }
.sg-title { font-size: 28rpx; font-weight: 600; color: #333; display: block; }
.sg-desc { font-size: 22rpx; color: #999; margin-top: 2rpx; display: block; }

.form-section { background: #fff; padding: 24rpx; margin-bottom: 2rpx; }
.form-item { margin-bottom: 20rpx; }
.form-label { font-size: 28rpx; color: #333; display: block; margin-bottom: 8rpx; }
.form-input { background: #f5f7fa; padding: 16rpx 20rpx; font-size: 28rpx; }
.form-textarea { width: 100%; height: 120rpx; background: #f5f7fa; padding: 16rpx 20rpx; font-size: 28rpx; box-sizing: border-box; }

.upload-section { background: #fff; padding: 24rpx; margin-bottom: 2rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #333; display: block; margin-bottom: 16rpx; }
.upload-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.upload-item { background: #f5f7fa; padding: 32rpx; text-align: center; }
.upload-icon { font-size: 44rpx; display: block; }
.upload-label { font-size: 26rpx; color: #666; margin-top: 8rpx; display: block; }

.agree-section { padding: 24rpx; display: flex; align-items: center; font-size: 26rpx; color: #666; }
.btn-submit { width: 90%; background: #1aad8a; color: #fff; height: 88rpx; line-height: 88rpx; font-size: 30rpx; margin-top: 20rpx; margin-left: 5%; }
.btn-submit[disabled] { background: #ccc; }
button::after { border: none; }
