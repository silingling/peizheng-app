page { background: #f7f8fa; }
.apply-header { background: linear-gradient(135deg, #07c160, #06ad56); padding: 48rpx 32rpx; text-align: center; }
.apply-title { font-size: 36rpx; font-weight: bold; color: #fff; display: block; }
.apply-desc { font-size: 24rpx; color: rgba(255,255,255,0.85); margin-top: 12rpx; display: block; }
.bg-wrap { padding: 16rpx; }
.bg-input { width: 100%; height: 120rpx; font-size: 28rpx; }
.agree-wrap { padding: 24rpx 16rpx; }
.submit-wrap { padding: 0 16rpx 40rpx; }
