page { background: #f7f8fa; }
.income-header { display: flex; background: #fff; padding: 40rpx 20rpx; margin-bottom: 2rpx; }
.inc-item { flex: 1; text-align: center; }
.inc-label { font-size: 24rpx; color: #999; display: block; }
.inc-num { font-size: 40rpx; font-weight: bold; color: #333; margin-top: 8rpx; display: block; }
.inc-num.red { color: #ee0a24; }
.inc-divider { width: 2rpx; background: #f0f0f0; }
