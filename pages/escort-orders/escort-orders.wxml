<view class="page">
  <van-tabs active="{{tab}}" bind:change="switchTab">
    <van-tab title="待服务"></van-tab>
    <van-tab title="服务中"></van-tab>
    <van-tab title="已完成"></van-tab>
  </van-tabs>

  <block wx:if="{{orders.length > 0}}">
    <van-cell wx:for="{{orders}}" wx:key="id" center>
    <view slot="title">
      <text>{{item.hospital}} · {{item.dept}}</text>
      <van-tag size="mini" type="{{item.statusClass == 'ongoing' ? 'primary' : item.statusClass == 'done' ? 'success' : 'warning'}}" style="margin-left:8rpx;">{{item.statusText}}</van-tag>
    </view>
    <view slot="label">{{item.date}} {{item.time}} · 患者：{{item.patient}} {{item.patientAge}}</view>
    <view slot="right-icon">
      <van-button wx:if="{{tab == 0}}" type="primary" size="mini" bind:click="startService">开始服务</van-button>
      <van-button wx:if="{{tab == 1}}" type="success" size="mini" bind:click="completeService">完成</van-button>
    </view>
  </van-cell>
  </block>
  <van-empty wx:else description="暂无订单" />
</view>
