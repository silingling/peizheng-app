page { background-color: #f5f7fa; }
.container { padding: 16rpx 0; }
.tabs { display: flex; background: #fff; padding: 8rpx; margin-bottom: 2rpx; }
.tab { flex: 1; text-align: center; padding: 16rpx 0; font-size: 28rpx; color: #666; }
.tab.active { background: #1aad8a; color: #fff; font-weight: 600; }
.empty { text-align: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; }
.empty-text { display: block; font-size: 32rpx; color: #333; margin-top: 20rpx; }
.empty-desc { display: block; font-size: 26rpx; color: #999; margin-top: 10rpx; }

.order-card { background: #fff; padding: 24rpx; margin-bottom: 2rpx; }
.order-header { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.oc-hospital { font-size: 30rpx; font-weight: 600; color: #333; }
.oc-status { font-size: 22rpx; padding: 4rpx 14rpx; }
.oc-status.pending { background: #fff7e6; color: #fa8c16; }
.oc-status.ongoing { background: #e6f7ff; color: #1890ff; }
.oc-status.done { background: #f6ffed; color: #52c41a; }
.oc-detail { font-size: 26rpx; color: #666; display: block; }
.oc-patient { font-size: 26rpx; color: #333; margin-top: 4rpx; display: block; }
.oc-desc { font-size: 24rpx; color: #999; margin-top: 4rpx; display: block; }
.order-actions { display: flex; gap: 16rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 2rpx solid #f0f0f0; }
.oa-btn { flex: 1; text-align: center; padding: 14rpx 0; font-size: 26rpx; border: 2rpx solid #ddd; color: #333; }
.oa-btn.call { border-color: #ddd; color: #666; }
.oa-btn.primary { background: #1aad8a; color: #fff; border-color: #1aad8a; }
