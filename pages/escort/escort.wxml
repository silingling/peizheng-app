<view class="page">
  <!-- 数据统计 -->
  <view class="stats-header">
    <view class="stat-item" wx:for="{{stats}}" wx:key="index">
      <text class="stat-num">{{item.num}}</text>
      <text class="stat-label">{{item.label}}</text>
    </view>
  </view>

  <!-- 提醒 -->
  <van-notice-bar text="您有 2 个待处理订单" left-icon="volume-o" bind:click="goMyOrders" />

  <!-- 快捷操作 -->
  <van-grid column-num="{{4}}" border="{{false}}" style="margin-top:12rpx;background:#fff;">
    <van-grid-item icon="orders-o" text="接单大厅" bind:click="goGrab" />
    <van-grid-item icon="records" text="我的订单" bind:click="goMyOrders" />
    <van-grid-item icon="gold-coin-o" text="收入中心" bind:click="goIncome" />
    <van-grid-item icon="contact" text="个人中心" use-button-slot>
      <view slot="button"><van-icon name="contact" size="28" color="#07c160" /></view>
      <text style="font-size:22rpx;color:#666;margin-top:4rpx;display:block;">个人资料</text>
    </van-grid-item>
  </van-grid>

  <!-- 今日服务 -->
  <van-cell-group title="📅 今日服务">
    <van-cell wx:for="{{todayOrders}}" wx:key="id">
      <view slot="title">
        <text>{{item.hospital}}</text>
        <van-tag type="{{item.statusClass == 'ongoing' ? 'primary' : 'warning'}}" size="mini" style="margin-left:8rpx;">{{item.statusText}}</van-tag>
      </view>
      <view slot="label">{{item.time}} · {{item.patient}}</view>
    </van-cell>
  </van-cell-group>

  <!-- 可接订单 -->
  <van-cell-group title="附近可接订单">
    <van-swipe-cell wx:for="{{grabOrders}}" wx:key="id" right-width="{{140}}">
      <van-cell title="{{item.hospital}}" :label="item.date + ' ' + item.time" :value="'¥' + item.price" />
      <view slot="right">
        <van-button type="primary" size="small" data-id="{{item.id}}" bind:click="grabOrder">接单</van-button>
      </view>
    </van-swipe-cell>
  </van-cell-group>
</view>
