<view class="container">
  <!-- 顶部数据卡片 -->
  <view class="stats-card">
    <view class="stat-item"><text class="stat-num">3</text><text class="stat-label">今日接单</text></view>
    <view class="stat-item"><text class="stat-num">¥480</text><text class="stat-label">今日收入</text></view>
    <view class="stat-item"><text class="stat-num">28</text><text class="stat-label">本月服务</text></view>
    <view class="stat-item"><text class="stat-num">4.9</text><text class="stat-label">综合评分</text></view>
  </view>

  <!-- 提醒卡片 -->
  <view class="remind-card" bindtap="goMyOrders">
    <text class="remind-icon">📢</text>
    <text class="remind-text">您有 2 个待处理订单</text>
    <text class="remind-arrow">›</text>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-actions">
    <view class="action-item" bindtap="goGrab"><text class="action-icon">📋</text><text class="action-name">接单大厅</text></view>
    <view class="action-item" bindtap="goMyOrders"><text class="action-icon">📝</text><text class="action-name">我的订单</text></view>
    <view class="action-item" bindtap="goIncome"><text class="action-icon">💰</text><text class="action-name">收入中心</text></view>
    <view class="action-item" bindtap="goProfile"><text class="action-icon">👤</text><text class="action-name">个人中心</text></view>
  </view>

  <!-- 今日服务提醒 -->
  <view class="today-card">
    <text class="today-title">📅 今日服务</text>
    <view class="today-order" wx:for="{{todayOrders}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="to-time">{{item.time}}</view>
      <view class="to-info">
        <text class="to-hospital">{{item.hospital}}</text>
        <text class="to-patient">{{item.patient}}</text>
      </view>
      <text class="to-status {{item.statusClass}}">{{item.statusText}}</text>
    </view>
  </view>

  <!-- 接单大厅 -->
  <text class="section-title">附近可接订单</text>
  <view class="grab-card" wx:for="{{grabOrders}}" wx:key="id">
    <view class="grab-header">
      <text class="grab-hospital">{{item.hospital}}</text>
      <text class="grab-dept">{{item.dept}}</text>
    </view>
    <view class="grab-body">
      <text class="grab-time">{{item.date}} {{item.time}}</text>
      <text class="grab-patient">{{item.patient}}</text>
    </view>
    <view class="grab-footer">
      <view class="gf-left">
        <text class="grab-price">¥{{item.price}}</text>
        <text class="grab-distance">{{item.distance}}</text>
      </view>
      <button class="btn-grab" data-id="{{item.id}}" bindtap="grabOrder">立即接单</button>
    </view>
  </view>
</view>
