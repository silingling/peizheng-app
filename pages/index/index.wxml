<view class="page">
  <!-- 搜索栏 -->
  <van-search value="{{searchVal}}" placeholder="搜索医院、科室..." />

  <!-- Banner 轮播 -->
  <van-swipe class="banner-swipe" autoplay="{{3000}}" circular indicator-color="white">
    <van-swipe-item wx:for="{{banners}}" wx:key="index">
      <view class="banner-item" style="background: {{item.bg}};">
        <text class="banner-title">{{item.title}}</text>
        <text class="banner-desc">{{item.desc}}</text>
        <van-tag type="white" plain class="banner-tag">{{item.tag}}</van-tag>
      </view>
    </van-swipe-item>
  </van-swipe>

  <!-- 数据统计 -->
  <view class="stats-row">
    <view class="stats-item" wx:for="{{stats}}" wx:key="index">
      <text class="stat-num">{{item.num}}</text>
      <text class="stat-label">{{item.label}}</text>
    </view>
  </view>

  <!-- 快捷服务 -->
  <view class="section-wrap">
    <view class="section-header">
      <text class="section-title">快捷服务</text>
    </view>
    <van-grid column-num="{{4}}" border="{{false}}">
      <van-grid-item icon="medel-o" text="就医陪诊" bind:click="goPatient" />
      <van-grid-item icon="description" text="代办服务" bind:click="goSubstitute" />
      <van-grid-item icon="flower-o" text="护士到家" bind:click="goNurse" />
      <van-grid-item icon="logistics" text="转运护送" bind:click="goHospice" />
    </van-grid>
  </view>

  <!-- 热门医院 -->
  <view class="section-wrap">
    <view class="section-header">
      <text class="section-title">热门医院</text>
    </view>
    <scroll-view class="hosp-scroll" scroll-x>
      <view class="hosp-card" wx:for="{{hospitals}}" wx:key="id" bindtap="goPatient">
        <text class="hosp-name">{{item.name}}</text>
        <text class="hosp-addr">{{item.shortAddr}}</text>
        <van-tag type="success" size="mini">已服务{{item.count}}人</van-tag>
      </view>
    </scroll-view>
  </view>

  <!-- 为什么选我们 -->
  <view class="section-wrap">
    <view class="section-header">
      <text class="section-title">为什么选择我们</text>
    </view>
    <van-grid column-num="{{3}}" border="{{false}}">
      <van-grid-item icon="clock-o" text="节省时间" use-button-slot>
        <view slot="button"><text class="grid-sub">熟悉流程减少等候</text></view>
      </van-grid-item>
      <van-grid-item icon="friends-o" text="专业可靠" use-button-slot>
        <view slot="button"><text class="grid-sub">实名认证经验丰富</text></view>
      </van-grid-item>
      <van-grid-item icon="like-o" text="贴心周到" use-button-slot>
        <view slot="button"><text class="grid-sub">全程陪同情绪安抚</text></view>
      </van-grid-item>
    </van-grid>
  </view>

  <view style="height: 120rpx;"></view>

  <!-- 底部入口 -->
  <van-goods-action>
    <van-goods-action-icon icon="friends-o" text="陪诊员端" bind:click="goEscort" />
    <van-goods-action-icon icon="manager-o" text="管理端" bind:click="goAdmin" />
  </van-goods-action>
</view>
