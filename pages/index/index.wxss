page { background: #f7f8fa; }

.banner-swipe { height: 360rpx; }
.banner-item { height: 360rpx; padding: 60rpx 40rpx; box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; }
.banner-title { font-size: 40rpx; font-weight: bold; color: #fff; display: block; }
.banner-desc { font-size: 26rpx; color: rgba(255,255,255,0.85); margin-top: 12rpx; display: block; }
.banner-tag { margin-top: 16rpx; align-self: flex-start; }

.stats-row { display: flex; background: #fff; padding: 20rpx 0; }
.stats-item { flex: 1; text-align: center; }
.stat-num { font-size: 34rpx; font-weight: bold; color: #07c160; display: block; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }

.section-wrap { background: #fff; margin-top: 12rpx; padding: 8rpx 0; }
.section-header { padding: 20rpx 16rpx 8rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #333; }

.hosp-scroll { white-space: nowrap; padding: 0 16rpx 20rpx; }
.hosp-card { display: inline-flex; flex-direction: column; background: #f7f8fa; padding: 20rpx; margin-right: 16rpx; width: 280rpx; }
.hosp-name { font-size: 26rpx; font-weight: 600; color: #333; }
.hosp-addr { font-size: 22rpx; color: #999; margin: 6rpx 0; }
.grid-sub { font-size: 20rpx; color: #999; display: block; text-align: center; margin-top: -10rpx; }
