page { background-color: #f5f7fa; }
.container { padding: 0; width: 100%; }

/* Banner */
.banner {
  background: linear-gradient(145deg, #1aad8a, #15967d, #20c997);
  padding: 40rpx 0 36rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.banner::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
}
.banner::after {
  content: '';
  position: absolute;
  bottom: -120rpx;
  left: -60rpx;
  width: 250rpx;
  height: 250rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.05);
}
.banner-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}
.banner-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 12rpx;
  display: block;
}
.banner-stats {
  display: flex;
  justify-content: space-around;
  margin-top: 24rpx;
}
.bs-num {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}
.bs-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 4rpx;
  display: block;
}

/* 通用区块 */
.section {
  padding: 30rpx 32rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 24rpx;
}

/* 角色卡片 */
.role-card {
  background: #fff;
  padding: 36rpx 32rpx;
  margin-bottom: 2rpx;
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  border-bottom: 2rpx solid #f0f0f0;
}
.role-card:active {
  background: #f8fbf8;
}
.role-icon {
  font-size: 56rpx;
  width: 90rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0faf5;
  border-radius: 16rpx;
  margin-right: 24rpx;
}
.role-info { flex: 1; }
.role-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
}
.role-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}
.arrow {
  font-size: 40rpx;
  color: #ccc;
}

/* 服务优势 */
.advantages {
  display: flex;
  gap: 16rpx;
}
.adv-item {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.adv-icon { 
  font-size: 52rpx; 
  display: block; 
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #f0faf5;
  border-radius: 44rpx;
  margin: 0 auto;
}
.adv-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-top: 12rpx;
  display: block;
}
.adv-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}
