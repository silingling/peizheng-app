<view class="page">
  <van-empty wx:if="{{records.length == 0}}" description="暂无就诊记录" />

  <view wx:else>
    <van-cell wx:for="{{records}}" wx:key="id" center>
      <view slot="title">
        <text>{{item.hospital}}</text>
        <van-tag type="success" size="mini" style="margin-left:8rpx;">{{item.dept}}</van-tag>
      </view>
      <view slot="label">
        <text>{{item.date}} · {{item.doctor}}</text>
        <text style="display:block;margin-top:6rpx;">诊断：{{item.diagnosis}}</text>
        <text style="display:block;color:#999;font-size:22rpx;margin-top:4rpx;">医嘱：{{item.advice}}</text>
      </view>
      <view slot="right-icon">
        <van-button size="mini" type="primary" plain data-hospital="{{item.hospital}}" data-dept="{{item.dept}}" bind:click="rebook">再来</van-button>
      </view>
    </van-cell>
  </view>
</view>
