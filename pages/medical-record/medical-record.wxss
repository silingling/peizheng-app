page { background-color: #f5f7fa; }
.container { padding: 20rpx 0; }
.section-title { font-size: 32rpx; font-weight: 600; color: #333; display: block; padding: 0 24rpx 20rpx; }
.empty { text-align: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; }
.empty-text { display: block; font-size: 32rpx; color: #333; margin-top: 16rpx; }
.empty-desc { display: block; font-size: 26rpx; color: #999; margin-top: 8rpx; }

.record-card { background: #fff; padding: 24rpx; margin-bottom: 2rpx; }
.rc-header { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.rc-hospital { font-size: 30rpx; font-weight: 600; color: #333; }
.rc-date { font-size: 24rpx; color: #999; }
.rc-dept { font-size: 26rpx; color: #666; display: block; }
.rc-diagnosis { font-size: 26rpx; color: #333; margin-top: 8rpx; display: block; }
.rc-advice { font-size: 24rpx; color: #888; margin-top: 4rpx; display: block; }
.rc-files { display: flex; gap: 8rpx; margin-top: 12rpx; }
.rc-file { font-size: 22rpx; color: #1aad8a; background: #e8faf0; padding: 4rpx 12rpx; }
.rc-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; padding-top: 12rpx; border-top: 2rpx solid #f0f0f0; }
.rc-escort { font-size: 22rpx; color: #999; }
.rc-again { font-size: 24rpx; color: #1aad8a; font-weight: 600; }
