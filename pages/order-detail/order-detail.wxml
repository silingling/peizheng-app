<view class="page">
  <!-- 进度条 -->
  <van-steps steps="{{progressSteps}}" active="{{order.progress}}" active-color="#07c160" />

  <!-- 陪诊员信息 -->
  <van-cell-group title="陪诊员信息">
    <van-cell center>
      <view slot="icon" class="escort-avatar">{{order.escortName[0]}}</view>
      <view slot="title">
        <text style="font-weight:600">{{order.escortName}}</text>
        <van-tag type="success" size="mini" style="margin-left:8rpx;">服务{{order.escortCount}}次</van-tag>
      </view>
      <view slot="label">
        <van-rate value="{{order.escortRating}}" size="12" readonly />
      </view>
      <view slot="right-icon" class="escort-actions">
        <van-icon name="phone-o" size="20" color="#07c160" bind:click="callEscort" />
        <van-icon name="chat-o" size="20" color="#1989fa" style="margin-left:16rpx;" bind:click="msgEscort" />
      </view>
    </van-cell>
  </van-cell-group>

  <!-- 就诊信息 -->
  <van-cell-group title="就诊信息">
    <van-cell title="服务类型" value="{{order.serviceType}}" />
    <van-cell title="就诊医院" value="{{order.hospital}}" />
    <van-cell title="就诊科室" value="{{order.dept}}" />
    <van-cell title="就诊时间" value="{{order.date}} {{order.time}}" />
    <van-cell title="就诊人" value="{{order.patientName}}" />
  </van-cell-group>

  <!-- 费用 -->
  <van-cell-group title="费用明细">
    <van-cell title="服务费" value="{{'¥' + order.price}}" />
    <van-cell title="合计" value="{{'¥' + order.price}}" title-class="total-label" value-class="total-value" />
  </van-cell-group>

  <view class="action-bar">
    <van-button wx:if="{{order.progress < 2}}" type="danger" plain bind:click="cancelOrder" class="act-btn">取消订单</van-button>
    <van-button type="primary" bind:click="contactCS" class="act-btn">联系客服</van-button>
  </view>
</view>
