page { background: #f7f8fa; }
.page { padding-bottom: 120rpx; }
.escort-avatar { width: 60rpx; height: 60rpx; border-radius: 50%; background: #07c160; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28rpx; margin-right: 12rpx; }
.escort-actions { display: flex; align-items: center; }
.action-bar { display: flex; gap: 16rpx; padding: 16rpx; position: fixed; bottom: 0; left: 0; right: 0; background: #fff; }
.act-btn { flex: 1; }
.total-label { font-size: 28rpx; font-weight: 600; }
.total-value { font-size: 36rpx; font-weight: bold; color: #ee0a24; }
