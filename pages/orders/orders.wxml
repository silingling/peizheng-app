<view class="page">
  <van-tabs active="{{tab}}" bind:change="switchTab">
    <van-tab title="全部"> </van-tab>
    <van-tab title="待服务"> </van-tab>
    <van-tab title="进行中"> </van-tab>
    <van-tab title="已完成"> </van-tab>
  </van-tabs>

  <van-empty wx:if="{{filteredOrders.length == 0}}" description="暂无订单" />

  <view wx:else>
    <view class="order-card" wx:for="{{filteredOrders}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail" wx:for-item="o">
      <van-card
        num="1"
        price="{{o.price}}"
        title="{{o.hospital}}"
        desc="{{o.dept}} · {{o.date}} {{o.time}}"
        tag="{{o.serviceType}}"
      >
        <view slot="tags">
          <van-tag type="{{o.statusClass == 'done' ? 'success' : o.statusClass == 'ongoing' ? 'primary' : 'warning'}}" size="mini">{{o.statusText}}</van-tag>
        </view>
        <view slot="footer">
          <text class="card-escort">👤 {{o.escort}}</text>
        </view>
      </van-card>
    </view>
  </view>

  <view class="order-count">共 {{filteredOrders.length}} 条订单</view>
</view>
