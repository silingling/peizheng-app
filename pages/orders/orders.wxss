page { background-color: #f5f7fa; }
.container { padding: 16rpx 0; }
.tabs {
  display: flex;
  background: #fff;
  padding: 8rpx;
  margin-bottom: 2rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
}
.tab.active {
  background: #1aad8a;
  color: #fff;
  font-weight: 600;
}
.empty { text-align: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; }
.empty-text { display: block; font-size: 32rpx; color: #333; margin-top: 20rpx; }
.empty-desc { display: block; font-size: 26rpx; color: #999; margin-top: 10rpx; }
.btn-go { margin-top: 40rpx; background: #1aad8a; color: #fff; width: 240rpx; height: 72rpx; line-height: 72rpx; font-size: 28rpx; }
button::after { border: none; }
.order-card {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 2rpx;
}
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}
.order-hospital { font-size: 30rpx; font-weight: 600; color: #333; }
.order-status { font-size: 24rpx; padding: 6rpx 16rpx; }
.order-status.pending { background: #fff7e6; color: #fa8c16; }
.order-status.ongoing { background: #e6f7ff; color: #1890ff; }
.order-status.done { background: #f6ffed; color: #52c41a; }
.order-info { display: flex; margin-bottom: 8rpx; }
.info-label { font-size: 26rpx; color: #999; width: 100rpx; }
.info-value { font-size: 26rpx; color: #333; flex: 1; }
