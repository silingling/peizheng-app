page { background-color: #f5f7fa; }
.container { padding: 20rpx 0; padding-bottom: 40rpx; }
.section-title { font-size: 32rpx; font-weight: 600; color: #333; display: block; padding: 0 24rpx 20rpx; }

.patient-card { background: #fff; padding: 24rpx; margin-bottom: 2rpx; }
.pc-header { display: flex; align-items: center; margin-bottom: 12rpx; }
.pc-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #1aad8a; color: #fff; font-size: 32rpx; display: flex; align-items: center; justify-content: center; margin-right: 16rpx; }
.pc-info { flex: 1; }
.pc-name { font-size: 30rpx; font-weight: 600; color: #333; display: block; }
.pc-relation { font-size: 24rpx; color: #999; margin-top: 4rpx; display: block; }
.pc-phone { font-size: 24rpx; color: #999; }
.pc-actions { display: flex; gap: 16rpx; padding-top: 12rpx; border-top: 2rpx solid #f0f0f0; }
.pca-btn { font-size: 24rpx; color: #666; }
.pca-btn.del { color: #ff4d4f; margin-left: auto; }

.add-card { background: #fff; padding: 32rpx; text-align: center; margin-top: 2rpx; }
.add-icon { font-size: 44rpx; font-weight: 300; color: #1aad8a; display: block; }
.add-text { font-size: 28rpx; color: #1aad8a; margin-top: 8rpx; display: block; }

/* 弹窗 */
.modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: flex-end; z-index: 100; }
.modal-content { width: 100%; background: #fff; border-radius: 20rpx 20rpx 0 0; padding: 40rpx 32rpx; }
.modal-title { font-size: 34rpx; font-weight: 600; color: #333; display: block; margin-bottom: 32rpx; }
.mf-group { margin-bottom: 24rpx; }
.mf-label { font-size: 26rpx; color: #666; display: block; margin-bottom: 8rpx; }
.mf-input { background: #f5f7fa; padding: 16rpx 20rpx; font-size: 28rpx; }
.mf-options { display: flex; flex-wrap: wrap; gap: 12rpx; }
.mfo { padding: 12rpx 28rpx; font-size: 26rpx; color: #666; background: #f5f7fa; }
.mfo.active { background: #1aad8a; color: #fff; }
.modal-actions { display: flex; gap: 16rpx; margin-top: 40rpx; }
.ma-cancel { flex: 1; background: #f5f7fa; color: #666; height: 80rpx; line-height: 80rpx; font-size: 28rpx; }
.ma-save { flex: 1; background: #1aad8a; color: #fff; height: 80rpx; line-height: 80rpx; font-size: 28rpx; }
button::after { border: none; }
