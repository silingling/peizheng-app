<view class="container">
  <!-- 步骤条 -->
  <view class="steps">
    <view class="step {{step >= 1 ? 'active' : ''}}">
      <view class="step-num">1</view>
      <text>选医院</text>
    </view>
    <view class="step-line {{step >= 2 ? 'active' : ''}}"></view>
    <view class="step {{step >= 2 ? 'active' : ''}}">
      <view class="step-num">2</view>
      <text>选科室</text>
    </view>
    <view class="step-line {{step >= 3 ? 'active' : ''}}"></view>
    <view class="step {{step >= 3 ? 'active' : ''}}">
      <view class="step-num">3</view>
      <text>填信息</text>
    </view>
  </view>

  <!-- 第一步：选择医院 -->
  <view class="form-section" wx:if="{{step == 1}}">
    <text class="section-title">选择医院</text>
    <input class="search-input" placeholder="搜索医院名称" bindinput="onSearchHospital" />
    
    <view class="hospital-list">
      <view class="hospital-card" wx:for="{{hospitals}}" wx:key="id" bindtap="selectHospital" data-id="{{item.id}}">
        <view class="hospital-name">{{item.name}}</view>
        <view class="hospital-addr">{{item.address}}</view>
      </view>
    </view>
  </view>

  <!-- 第二步：选择科室和时间 -->
  <view class="form-section" wx:if="{{step == 2}}">
    <text class="section-title">选择科室</text>
    <view class="tag-group">
      <view class="tag {{selectedDept == index ? 'active' : ''}}" 
            wx:for="{{departments}}" wx:key="index"
            bindtap="selectDept" data-index="{{index}}">
        {{item}}
      </view>
    </view>

    <text class="section-title" style="margin-top: 30rpx;">选择日期</text>
    <view class="date-list">
      <view class="date-item {{selectedDate == index ? 'active' : ''}}"
            wx:for="{{dates}}" wx:key="index"
            bindtap="selectDate" data-index="{{index}}">
        <text class="date-week">{{item.week}}</text>
        <text class="date-day">{{item.day}}</text>
      </view>
    </view>

    <text class="section-title" style="margin-top: 30rpx;">选择时段</text>
    <view class="tag-group">
      <view class="tag {{selectedTime == index ? 'active' : ''}}"
            wx:for="{{times}}" wx:key="index"
            bindtap="selectTime" data-index="{{index}}">
        {{item}}
      </view>
    </view>
  </view>

  <!-- 第三步：填写患者信息 -->
  <view class="form-section" wx:if="{{step == 3}}">
    <text class="section-title">患者信息</text>
    
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input class="form-input" placeholder="请输入患者姓名" bindinput="onInputName" />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" placeholder="请输入手机号" type="number" bindinput="onInputPhone" />
    </view>
    <view class="form-item">
      <text class="form-label">病症描述</text>
      <textarea class="form-textarea" placeholder="请简要描述症状，方便陪诊员提前准备" bindinput="onInputDesc"></textarea>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="btn-area">
    <button class="btn-prev" wx:if="{{step > 1}}" bindtap="prevStep">上一步</button>
    <button class="btn-next" bindtap="nextStep">{{step < 3 ? '下一步' : '确认预约'}}</button>
  </view>
</view>
