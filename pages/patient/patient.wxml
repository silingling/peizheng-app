<view class="page">
  <van-steps steps="{{steps}}" active="{{step}}" active-color="#07c160" />

  <!-- Step 1 -->
  <view wx:if="{{step == 0}}">
    <van-cell-group title="服务类型">
      <van-cell wx:for="{{serviceTypes}}" wx:key="index" title="{{item}}" label="{{serviceLabels[index]}}" data-index="{{index}}" bind:click="selectService">
        <van-icon slot="right-icon" name="success" color="#07c160" wx:if="{{serviceType == index}}" />
      </van-cell>
    </van-cell-group>

    <van-cell-group title="选择医院">
      <van-cell wx:for="{{hospitals}}" wx:key="id" title="{{item.name}}" label="{{item.shortAddr}}" data-id="{{item.id}}" bind:click="selectHospital">
        <van-icon slot="right-icon" name="success" color="#07c160" wx:if="{{selectedHospital == item.id}}" />
      </van-cell>
    </van-cell-group>

    <van-cell-group title="选择科室">
      <van-cell wx:for="{{departments}}" wx:key="index" title="{{item}}" data-index="{{index}}" bind:click="selectDept">
        <van-icon slot="right-icon" name="success" color="#07c160" wx:if="{{selectedDept == index}}" />
      </van-cell>
    </van-cell-group>
  </view>

  <!-- Step 2 -->
  <view wx:if="{{step == 1}}">
    <van-cell-group title="选择就诊人">
      <van-cell title="{{userName}}（本人）" label="{{userPhone}}" bind:click="selectSelf">
        <van-icon slot="right-icon" name="success" color="#07c160" wx:if="{{patientType == 'self'}}" />
      </van-cell>
      <van-cell wx:for="{{familyPatients}}" wx:key="id" title="{{item.name}}（{{item.relation}}）" label="{{item.phone}}" data-index="{{idx}}" bind:click="selectFamily">
        <van-icon slot="right-icon" name="success" color="#07c160" wx:if="{{patientType == idx}}" />
      </van-cell>
      <van-cell title="+ 添加就诊人" title-class="add-title" bind:click="addPatient" />
    </van-cell-group>

    <van-cell-group title="选择日期">
      <van-cell wx:for="{{dates}}" wx:key="index" :title="item.week" :label="item.day" data-index="{{index}}" bind:click="selectDate">
        <van-icon slot="right-icon" name="success" color="#07c160" wx:if="{{selectedDate == index}}" />
      </van-cell>
    </van-cell-group>

    <van-cell-group title="选择时段">
      <van-cell wx:for="{{times}}" wx:key="index" title="{{item}}" data-index="{{index}}" bind:click="selectTime">
        <van-icon slot="right-icon" name="success" color="#07c160" wx:if="{{selectedTime == index}}" />
      </van-cell>
    </van-cell-group>
  </view>

  <!-- Step 3 -->
  <view wx:if="{{step == 2}}">
    <van-cell-group title="确认订单信息">
      <van-cell title="服务类型" value="{{serviceTypes[serviceType]}}" />
      <van-cell title="就诊医院" value="{{hospitalName}}" />
      <van-cell title="就诊科室" value="{{deptName}}" />
      <van-cell title="就诊时间" value="{{dateStr}} {{timeStr}}" />
      <van-cell title="就诊人" value="{{patientName}}" />
    </van-cell-group>

    <van-cell-group title="病情描述（选填）">
      <view class="desc-wrap">
        <textarea class="desc-input" placeholder="请简要描述症状，方便陪诊员提前准备" bindinput="onInputDesc" />
      </view>
    </van-cell-group>

    <van-cell title="服务费用" value="{{'¥' + servicePrice}}" title-class="price-label" value-class="price-value" />
  </view>

  <view class="btn-wrap">
    <van-button wx:if="{{step > 0}}" type="default" bind:click="prevStep" class="btn-half" size="large">上一步</van-button>
    <van-button type="primary" bind:click="nextStep" class="btn-half" size="large">
      {{step < 2 ? '下一步' : '提交预约'}}
    </van-button>
  </view>
</view>
