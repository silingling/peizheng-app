page { background-color: #f5f7fa; }
.container { padding: 20rpx 0; }

/* 步骤条 */
.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}
.step { text-align: center; }
.step-num {
  width: 50rpx; height: 50rpx;
  border-radius: 50%;
  background: #ddd;
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 8rpx;
}
.step.active .step-num { background: #1aad8a; }
.step text { font-size: 24rpx; color: #999; }
.step.active text { color: #1aad8a; }
.step-line {
  width: 80rpx; height: 4rpx;
  background: #ddd;
  margin: 0 16rpx;
  margin-bottom: 40rpx;
}
.step-line.active { background: #1aad8a; }

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
}
.search-input {
  background: #fff;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin: 0 0 20rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}
.hospital-card {
  background: #fff;
  padding: 24rpx 24rpx;
  margin-bottom: 2rpx;
  border-bottom: 2rpx solid #f0f0f0;
}
.hospital-name { font-size: 30rpx; font-weight: 600; color: #333; }
.hospital-addr { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 24rpx;
}
.tag {
  background: #fff;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: #666;
  border: 2rpx solid #eee;
}
.tag.active {
  background: #e8faf0;
  color: #1aad8a;
  border-color: #1aad8a;
}
.date-list {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx;
}
.date-item {
  background: #fff;
  padding: 16rpx 24rpx;
  text-align: center;
  border: 2rpx solid #eee;
}
.date-item.active {
  background: #e8faf0;
  border-color: #1aad8a;
}
.date-week { font-size: 24rpx; color: #999; display: block; }
.date-day { font-size: 32rpx; font-weight: 600; color: #333; display: block; margin-top: 4rpx; }
.form-item {
  background: #fff;
  padding: 20rpx 24rpx;
  margin-bottom: 2rpx;
}
.form-label { font-size: 28rpx; color: #333; display: block; margin-bottom: 12rpx; }
.form-input { font-size: 28rpx; width: 100%; }
.form-textarea { width: 100%; height: 140rpx; font-size: 28rpx; }
.btn-area {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
  padding: 0 24rpx 40rpx;
}
.btn-prev {
  flex: 1;
  background: #fff;
  color: #333;
  border: 2rpx solid #ddd;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}
.btn-next {
  flex: 2;
  background: #1aad8a;
  color: #fff;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}
button::after { border: none; }
