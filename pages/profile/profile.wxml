<view class="page">
  <!-- 用户头部 -->
  <view class="user-header">
    <view class="user-avatar">{{userName[0]}}</view>
    <view class="user-info">
      <text class="user-name">{{userName}}</text>
      <text class="user-phone">{{userPhone}}</text>
    </view>
    <van-tag type="primary" size="medium">患者端</van-tag>
  </view>

  <!-- 快捷入口 -->
  <van-cell-group style="margin-top:12rpx;">
    <van-cell title="就诊人管理" icon="contact" is-link bind:click="goPatientManages" />
    <van-cell title="就诊档案" icon="records" is-link :value="recordsCount + '条'" bind:click="goRecords" />
    <van-cell title="我的订单" icon="orders-o" is-link bind:click="goOrders" />
    <van-cell title="收藏陪诊员" icon="star-o" is-link bind:click="goFavorites" />
  </van-cell-group>

  <!-- 最近服务 -->
  <van-cell-group title="最近服务">
    <van-cell wx:for="{{recentOrders}}" wx:key="id" title="{{item.hospital}}" :label="item.date + ' · ' + item.dept" data-id="{{item.id}}" is-link bind:click="goDetail">
      <view slot="right-icon">
        <van-tag type="{{item.statusClass == 'done' ? 'success' : item.statusClass == 'ongoing' ? 'primary' : 'warning'}}" size="mini">{{item.statusText}}</van-tag>
      </view>
    </van-cell>
  </van-cell-group>

  <!-- 设置 -->
  <van-cell-group style="margin-top:12rpx;">
    <van-cell title="联系客服" icon="service-o" is-link bind:click="contactCS" />
    <van-cell title="推荐给朋友" icon="share-o" is-link bind:click="shareApp" />
    <van-cell title="切换到陪诊员端" icon="exchange" is-link bind:click="switchRole" />
  </van-cell-group>
</view>
