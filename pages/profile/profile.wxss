page { background: #f7f8fa; }
.user-header { background: linear-gradient(135deg, #07c160, #06ad56); padding: 48rpx 32rpx; display: flex; align-items: center; }
.user-avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: rgba(255,255,255,0.25); color: #fff; font-size: 44rpx; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; }
.user-info { flex: 1; }
.user-name { font-size: 36rpx; font-weight: bold; color: #fff; display: block; }
.user-phone { font-size: 24rpx; color: rgba(255,255,255,0.8); margin-top: 4rpx; display: block; }
